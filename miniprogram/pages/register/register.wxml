<view class="mp-page register-page">
  <view class="register-shell">
    <view class="mp-hero register-hero">
      <view class="mp-eyebrow">Sign Up</view>
      <view class="mp-title">加入校园租赁</view>
      <view class="mp-subtitle">注册账号后即可发布物品、租赁交易。</view>
    </view>

    <view class="mp-panel register-panel">
      <view class="mp-panel-body">
        <view class="mp-section-head">
          <view>
            <view class="mp-section-title">账号注册</view>
            <view class="mp-section-desc">请填写以下信息完成注册。</view>
          </view>
        </view>

        <view class="register-form">
          <view class="register-field">
            <view class="register-label">学号 / 手机号</view>
            <input class="register-input" placeholder="请输入学号或手机号" bindinput="onUsernameInput" />
          </view>
          <view class="register-field">
            <view class="register-label">昵称（选填）</view>
            <input class="register-input" placeholder="请输入昵称" bindinput="onNicknameInput" />
          </view>
          <view class="register-field">
            <view class="register-label">密码</view>
            <input class="register-input" placeholder="请输入密码（至少6位）" password bindinput="onPasswordInput" />
          </view>
          <view class="register-field">
            <view class="register-label">确认密码</view>
            <input class="register-input" placeholder="请再次输入密码" password bindinput="onConfirmPasswordInput" />
          </view>
          <button class="mp-primary-btn register-submit" bindtap="handleRegister">立即注册</button>
        </view>
      </view>
    </view>

    <view class="register-footer">
      <text class="register-footer-text">已有账号？</text>
      <text class="register-footer-link" bindtap="goToLogin">去登录</text>
    </view>
  </view>
</view>
