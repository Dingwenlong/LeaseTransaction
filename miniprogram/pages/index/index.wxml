<view class="mp-page home-page">
  <view class="mp-shell">
    <view class="mp-hero home-hero">
      <view class="home-hero-top">
        <view class="home-hero-copy">
          <view class="mp-eyebrow">Campus Lease</view>
          <view class="mp-title">校园租赁交易</view>
          <view class="mp-subtitle">支持搜索、分类筛选和附近推荐。</view>
          <view wx:if="{{usingMockData}}" class="mp-meta-pill">首页演示数据</view>
        </view>
      </view>

      <view class="mp-search home-search">
        <input
          class="mp-search-input"
          placeholder="搜索物品、分类或校区"
          value="{{searchKeyword}}"
          bindinput="onSearchInput"
          confirm-type="search"
          bindconfirm="onSearch"
        />
        <view class="home-search-action" bindtap="onSearch">搜索</view>
      </view>

      <view wx:if="{{searchHistory.length > 0 && !hasSearchKeyword}}" class="home-history">
        <view class="home-history-head">
          <view class="home-history-title">最近搜索</view>
          <view class="home-history-clear" bindtap="onClearHistory">清空</view>
        </view>
        <view class="mp-chip-row home-history-row">
          <view
            wx:for="{{searchHistory}}"
            wx:key="index"
            class="mp-chip home-history-chip"
            bindtap="onHistoryTap"
            data-keyword="{{item}}"
          >
            <text class="home-history-icon">⏱</text>
            <text class="home-history-text mp-ellipsis">{{item}}</text>
          </view>
        </view>
      </view>

      <view class="mp-chip-row home-tabs">
        <view
          wx:for="{{tabs}}"
          wx:key="index"
          class="mp-chip {{activeTab === index ? 'mp-chip-active' : ''}}"
          bindtap="onTabTap"
          data-index="{{index}}"
        >
          {{item}}
        </view>
      </view>
    </view>

    <swiper wx:if="{{showHomeHighlights && banners.length > 0}}" class="home-banner-swiper" indicator-dots autoplay circular interval="4000">
      <swiper-item wx:for="{{banners}}" wx:key="index">
        <view class="mp-panel home-banner">
          <view class="mp-panel-body">
            <view class="home-banner-title">{{item.title}}</view>
            <view class="home-banner-subtitle">{{item.subtitle}}</view>
          </view>
        </view>
      </swiper-item>
    </swiper>

    <view class="mp-panel" wx:if="{{showHomeHighlights && announcements.length > 0}}">
      <view class="mp-panel-body">
        <view class="mp-section-head">
          <view>
            <view class="mp-section-title">平台公告</view>
            <view class="mp-section-desc">查看审核、认证和安全交易提醒。</view>
          </view>
        </view>
        <view class="home-notice-list">
          <view wx:for="{{announcements}}" wx:key="index" class="home-notice-item">
            <view class="home-notice-title">{{item.title}}</view>
            <view class="home-notice-desc">{{item.content}}</view>
          </view>
        </view>
      </view>
    </view>

    <view class="mp-section-head">
      <view>
        <view class="mp-section-title">分类导航</view>
        <view class="mp-section-desc">按类目快速切换物品列表。</view>
      </view>
      <view class="mp-meta-pill">{{activeCategory}}</view>
    </view>

    <view class="mp-chip-row home-category-row">
      <view
        wx:for="{{categories}}"
        wx:key="index"
        class="mp-chip {{activeCategory === item ? 'mp-chip-active' : ''}}"
        bindtap="onCategoryTap"
        data-category="{{item}}"
      >
        {{item}}
      </view>
    </view>

    <view class="mp-section-head">
      <view>
        <view class="mp-section-title">精选物品</view>
        <view class="mp-section-desc">查看物品标题、校区、价格和模式。</view>
      </view>
      <view class="mp-meta-pill">共 {{items.length}} 件</view>
    </view>

    <view class="home-grid">
      <view
        wx:for="{{items}}"
        wx:key="id"
        class="mp-panel home-card"
        bindtap="onItemTap"
        data-id="{{item.id}}"
      >
        <image class="home-card-image" src="{{item.image}}" mode="aspectFill" />
        <view class="mp-panel-body home-card-body">
          <view class="home-card-head">
            <view class="home-card-title mp-ellipsis">{{item.title}}</view>
            <view class="mp-tag {{item.typeClass === 'lease' ? 'mp-tag-cyan' : 'mp-tag-magenta'}}">
              {{item.type}}
            </view>
          </view>
          <view class="home-card-location mp-ellipsis">📍 {{item.location}}</view>
          <view class="home-card-hint">{{item.reviewHint}}</view>
          <view class="home-card-footer">
            <view class="home-card-price">
              <text class="home-card-price-symbol">¥</text>
              <text class="home-card-price-value">{{item.price}}</text>
            </view>
            <view class="mp-meta-pill">查看详情</view>
          </view>
        </view>
      </view>
    </view>

    <view class="mp-section-head" wx:if="{{nearbyItems.length > 0}}">
      <view>
        <view class="mp-section-title">附近推荐</view>
        <view class="mp-section-desc">优先展示当前校区附近的物品。</view>
      </view>
      <view class="mp-meta-pill">Nearby</view>
    </view>

    <scroll-view wx:if="{{nearbyItems.length > 0}}" class="home-nearby-scroll" scroll-x enable-flex>
      <view class="home-nearby-row">
        <view
          wx:for="{{nearbyItems}}"
          wx:key="id"
          class="mp-panel home-nearby-card"
          bindtap="onNearbyTap"
          data-id="{{item.id}}"
        >
          <image class="home-nearby-image" src="{{item.image}}" mode="aspectFill" />
          <view class="mp-panel-body home-nearby-body">
            <view class="home-nearby-title mp-ellipsis">{{item.title}}</view>
            <view class="home-nearby-meta">{{item.location}} · {{item.type}}</view>
            <view class="home-nearby-price">¥{{item.price}}</view>
          </view>
        </view>
      </view>
    </scroll-view>

    <view class="mp-empty" wx:if="{{items.length === 0}}">
      <text class="mp-empty-icon">🔍</text>
      <text class="mp-empty-title">暂无匹配物品</text>
      <text class="mp-empty-text">可以更换关键词、模式或分类后重试。</text>
    </view>
  </view>

  <view class="home-publish" bindtap="onPublishTap">
    <text class="home-publish-icon">＋</text>
    <text class="home-publish-text">发布物品</text>
  </view>
</view>
