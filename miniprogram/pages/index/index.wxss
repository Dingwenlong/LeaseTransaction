.home-page {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.home-hero {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.home-hero-top {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  align-items: flex-start;
  min-width: 0;
}

.home-hero-copy {
  flex: 1;
  min-width: 0;
}

.home-search-action {
  flex-shrink: 0;
  min-width: 108rpx;
  height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: linear-gradient(135deg, rgba(34, 211, 238, 0.9), rgba(236, 72, 153, 0.8));
  color: #04111f;
  font-size: 24rpx;
  font-weight: 700;
}

.home-tabs .mp-chip {
  flex: 1 1 0;
}

.home-banner-swiper {
  width: 100%;
  height: 240rpx;
}

.home-banner {
  height: 100%;
}

.home-banner-title {
  margin-top: 14rpx;
  color: #ffffff;
  font-size: 38rpx;
  font-weight: 800;
}

.home-banner-subtitle {
  margin-top: 12rpx;
  color: #cbd5e1;
  font-size: 24rpx;
  line-height: 1.6;
}

.home-notice-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-top: 24rpx;
}

.home-notice-item {
  padding: 22rpx 24rpx;
  border-radius: 24rpx;
  background: rgba(15, 23, 42, 0.62);
  border: 1rpx solid rgba(148, 163, 184, 0.12);
}

.home-notice-title {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.home-notice-desc {
  margin-top: 10rpx;
  color: #94a3b8;
  font-size: 24rpx;
  line-height: 1.7;
}

.home-category-row {
  flex-wrap: nowrap;
  overflow-x: auto;
  padding-bottom: 6rpx;
}

.home-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
  min-width: 0;
}

.home-card {
  min-width: 0;
}

.home-card-image {
  width: 100%;
  height: 280rpx;
  background: #13233d;
}

.home-card-body {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.home-card-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  min-width: 0;
}

.home-card-title {
  flex: 1;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.home-card-location {
  color: #94a3b8;
  font-size: 22rpx;
}

.home-card-hint {
  min-height: 68rpx;
  color: #cbd5e1;
  font-size: 22rpx;
  line-height: 1.55;
}

.home-card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.home-card-price {
  display: flex;
  align-items: baseline;
}

.home-card-price-symbol {
  color: #fde047;
  font-size: 24rpx;
  font-weight: 700;
}

.home-card-price-value {
  color: #fde047;
  font-size: 38rpx;
  font-weight: 800;
}

.home-nearby-scroll {
  width: 100%;
  white-space: nowrap;
}

.home-nearby-row {
  display: inline-flex;
  gap: 18rpx;
  padding-right: 24rpx;
}

.home-nearby-card {
  width: 320rpx;
  overflow: hidden;
}

.home-nearby-image {
  width: 100%;
  height: 190rpx;
  background: #13233d;
}

.home-nearby-body {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.home-nearby-title {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.home-nearby-meta {
  color: #94a3b8;
  font-size: 22rpx;
}

.home-nearby-price {
  color: #fde047;
  font-size: 34rpx;
  font-weight: 800;
}

.home-publish {
  position: fixed;
  right: 24rpx;
  bottom: calc(118rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  height: 88rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  background: linear-gradient(135deg, #22d3ee, #ec4899);
  color: #04111f;
  box-shadow: 0 18rpx 36rpx rgba(34, 211, 238, 0.2);
  z-index: 20;
}

.home-publish-icon {
  font-size: 34rpx;
  line-height: 1;
}

.home-publish-text {
  font-size: 26rpx;
  font-weight: 700;
  white-space: nowrap;
}

@media (max-width: 360px) {
  .home-grid {
    grid-template-columns: 1fr;
  }

  .home-hero-top {
    flex-direction: column;
  }

  .home-search-action {
    min-width: 92rpx;
  }
}
