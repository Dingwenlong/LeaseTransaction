.container {
  min-height: 100vh;
  background: #0f172a;
  padding-bottom: 120rpx;
}

.header {
  padding: 30rpx;
  background: linear-gradient(180deg, #1e1b4b 0%, #0f172a 100%);
}

.search-bar {
  display: flex;
  align-items: center;
  background: rgba(30, 41, 59, 0.9);
  border: 3rpx solid #22d3ee;
  border-radius: 50rpx;
  padding: 20rpx 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 4rpx 4rpx 0px rgba(34, 211, 238, 0.3);
}

.search-input {
  flex: 1;
  color: #fff;
  font-size: 28rpx;
}

.search-btn {
  color: #22d3ee;
  font-size: 32rpx;
  margin-left: 20rpx;
}

.filter-tabs {
  display: flex;
  gap: 20rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  background: rgba(30, 41, 59, 0.8);
  border: 2rpx solid #64748b;
  border-radius: 10rpx;
  color: #94a3b8;
  font-size: 28rpx;
  transition: all 0.3s;
}

.tab.active {
  background: linear-gradient(90deg, #22d3ee, #0891b2);
  border-color: #22d3ee;
  color: #fff;
  font-weight: bold;
  box-shadow: 0 0 20rpx rgba(34, 211, 238, 0.4);
}

.item-list {
  padding: 30rpx;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 30rpx;
}

.item-card {
  background: rgba(30, 41, 59, 0.9);
  border: 2rpx solid #334155;
  border-radius: 16rpx;
  overflow: hidden;
  box-shadow: 4rpx 4rpx 0px rgba(51, 65, 85, 0.5);
}

.item-image {
  width: 100%;
  height: 280rpx;
  background: #1e293b;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
}

.item-info {
  padding: 24rpx;
}

.item-title {
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 16rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-location {
  color: #94a3b8;
  font-size: 22rpx;
  margin-bottom: 16rpx;
}

.item-bottom {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.item-price {
  display: flex;
  align-items: baseline;
}

.price-symbol {
  color: #fbbf24;
  font-size: 24rpx;
  font-weight: bold;
}

.price-value {
  color: #fbbf24;
  font-size: 36rpx;
  font-weight: bold;
}

.item-type {
  padding: 8rpx 16rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  font-weight: bold;
}

.item-type.lease {
  background: rgba(34, 211, 238, 0.2);
  color: #22d3ee;
  border: 1rpx solid #22d3ee;
}

.item-type.sale {
  background: rgba(236, 72, 153, 0.2);
  color: #ec4899;
  border: 1rpx solid #ec4899;
}

.publish-btn {
  position: fixed;
  right: 30rpx;
  bottom: 150rpx;
  width: 140rpx;
  height: 140rpx;
  background: linear-gradient(135deg, #ec4899, #a855f7);
  border: 4rpx solid #fff;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 30rpx rgba(236, 72, 153, 0.5);
  z-index: 100;
}

.publish-icon {
  font-size: 48rpx;
  color: #fff;
  line-height: 1;
}

.publish-text {
  font-size: 22rpx;
  color: #fff;
  font-weight: bold;
  margin-top: 4rpx;
}
