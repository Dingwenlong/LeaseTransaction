.home-page {
  padding-bottom: calc(180rpx + env(safe-area-inset-bottom));
}

.home-hero {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.home-hero-top {
  display: flex;
  justify-content: space-between;
  gap: 20rpx;
  align-items: flex-start;
  min-width: 0;
}

.home-hero-copy {
  flex: 1;
  min-width: 0;
}

.home-hero-tag {
  flex-shrink: 0;
  min-width: 120rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.2);
  background: rgba(15, 23, 42, 0.72);
  color: #67e8f9;
  font-size: 24rpx;
  font-weight: 700;
}

.home-search-action {
  flex-shrink: 0;
  min-width: 108rpx;
  height: 66rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999rpx;
  background: linear-gradient(135deg, rgba(34, 211, 238, 0.9), rgba(236, 72, 153, 0.8));
  color: #04111f;
  font-size: 24rpx;
  font-weight: 700;
}

.home-tabs .mp-chip {
  flex: 1 1 0;
}

.home-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20rpx;
  min-width: 0;
}

.home-card {
  min-width: 0;
}

.home-card-image {
  width: 100%;
  height: 280rpx;
  background: #13233d;
}

.home-card-body {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.home-card-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  min-width: 0;
}

.home-card-title {
  flex: 1;
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.home-card-location {
  color: #94a3b8;
  font-size: 22rpx;
}

.home-card-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.home-card-price {
  display: flex;
  align-items: baseline;
}

.home-card-price-symbol {
  color: #fde047;
  font-size: 24rpx;
  font-weight: 700;
}

.home-card-price-value {
  color: #fde047;
  font-size: 38rpx;
  font-weight: 800;
}

.home-publish {
  position: fixed;
  right: 24rpx;
  bottom: calc(118rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 12rpx;
  min-width: 0;
  height: 88rpx;
  padding: 0 28rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  background: linear-gradient(135deg, #22d3ee, #ec4899);
  color: #04111f;
  box-shadow: 0 18rpx 36rpx rgba(34, 211, 238, 0.2);
  z-index: 20;
}

.home-publish-icon {
  font-size: 34rpx;
  line-height: 1;
}

.home-publish-text {
  font-size: 26rpx;
  font-weight: 700;
  white-space: nowrap;
}

@media (max-width: 360px) {
  .home-grid {
    grid-template-columns: 1fr;
  }

  .home-hero-top {
    flex-direction: column;
  }

  .home-search-action {
    min-width: 92rpx;
  }
}
