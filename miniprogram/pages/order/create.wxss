.create-order-page {
  padding-bottom: 0;
}

.create-order-item {
  display: flex;
  gap: 18rpx;
  margin-top: 24rpx;
}

.create-order-image {
  width: 180rpx;
  height: 180rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
  background: #13233d;
}

.create-order-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.create-order-title {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 800;
  line-height: 1.4;
}

.create-order-price {
  color: #fde047;
  font-size: 44rpx;
  font-weight: 800;
}

.create-order-form {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  margin-top: 24rpx;
}

.create-order-field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.create-order-label {
  color: #e2e8f0;
  font-size: 26rpx;
  font-weight: 700;
}

.create-order-input,
.create-order-textarea {
  width: 100%;
  min-width: 0;
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  border-radius: 24rpx;
  color: #ffffff;
  background: rgba(15, 23, 42, 0.76);
}

.create-order-input {
  min-height: 88rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  font-size: 28rpx;
}

.create-order-textarea {
  min-height: 180rpx;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.7;
}

@media (max-width: 360px) {
  .create-order-item {
    flex-direction: column;
  }

  .create-order-image {
    width: 100%;
    height: 300rpx;
  }
}
