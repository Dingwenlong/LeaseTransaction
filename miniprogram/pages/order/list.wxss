.container {
  min-height: 100vh;
  background: #0f172a;
}

.tabs {
  display: flex;
  background: rgba(30, 41, 59, 0.9);
  border-bottom: 2rpx solid #334155;
  padding: 20rpx 0;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  color: #94a3b8;
  font-size: 28rpx;
  position: relative;
}

.tab.active {
  color: #22d3ee;
  font-weight: bold;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: linear-gradient(90deg, #22d3ee, #ec4899);
  border-radius: 2rpx;
}

.order-list {
  padding: 20rpx;
}

.order-card {
  background: rgba(30, 41, 59, 0.9);
  border: 2rpx solid #334155;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 4rpx 4rpx 0px rgba(51, 65, 85, 0.5);
}

.order-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid #334155;
}

.order-no {
  color: #94a3b8;
  font-size: 24rpx;
  font-family: monospace;
}

.order-status {
  padding: 8rpx 20rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  font-weight: bold;
}

.order-status.pending {
  background: rgba(251, 191, 36, 0.2);
  color: #fbbf24;
  border: 1rpx solid #fbbf24;
}

.order-status.progress {
  background: rgba(34, 211, 238, 0.2);
  color: #22d3ee;
  border: 1rpx solid #22d3ee;
}

.order-status.completed {
  background: rgba(34, 197, 94, 0.2);
  color: #22c55e;
  border: 1rpx solid #22c55e;
}

.order-status.cancelled {
  background: rgba(100, 116, 139, 0.2);
  color: #64748b;
  border: 1rpx solid #64748b;
}

.order-content {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}

.item-image {
  width: 160rpx;
  height: 160rpx;
  background: #1e293b;
  border-radius: 12rpx;
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.item-title {
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
  overflow: hidden;
  text-overflow: ellipsis;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.item-type {
  align-self: flex-start;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  font-weight: bold;
}

.item-type.lease {
  background: rgba(34, 211, 238, 0.2);
  color: #22d3ee;
  border: 1rpx solid #22d3ee;
}

.item-type.sale {
  background: rgba(236, 72, 153, 0.2);
  color: #ec4899;
  border: 1rpx solid #ec4899;
}

.order-footer {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  border-top: 1rpx solid #334155;
}

.order-time {
  color: #64748b;
  font-size: 24rpx;
}

.order-amount {
  color: #fbbf24;
  font-size: 32rpx;
  font-weight: bold;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  color: #64748b;
  font-size: 28rpx;
}
