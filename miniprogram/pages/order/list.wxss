.order-tabs .mp-chip {
  flex: 1 1 0;
}

.message-tab-badge {
  min-width: 32rpx;
  height: 32rpx;
  padding: 0 8rpx;
  border-radius: 999rpx;
  background: rgba(244, 63, 94, 0.9);
  color: #ffffff;
  font-size: 20rpx;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.order-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.order-card-body {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.order-card-head,
.order-card-foot {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  min-width: 0;
}

.order-card-no {
  flex: 1;
  color: #cbd5e1;
  font-size: 22rpx;
  line-height: 1.6;
}

.order-card-main {
  display: flex;
  gap: 18rpx;
  min-width: 0;
}

.order-card-image {
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
  background: #13233d;
}

.order-card-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 14rpx;
}

.order-card-title {
  color: #ffffff;
  font-size: 30rpx;
  line-height: 1.5;
  font-weight: 700;
  word-break: break-word;
}

.order-card-time {
  color: #64748b;
  font-size: 22rpx;
}

.order-card-amount {
  color: #fde047;
  font-size: 36rpx;
  font-weight: 800;
}

@media (max-width: 360px) {
  .order-card-head,
  .order-card-foot {
    flex-direction: column;
  }

  .order-card-main {
    flex-direction: column;
  }

  .order-card-image {
    width: 100%;
    height: 280rpx;
  }
}
