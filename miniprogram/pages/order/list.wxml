<view class="container">
  <view class="tabs">
    <view class="tab {{activeTab === 0 ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="index" bindtap="onTabTap" data-index="{{index}}">
      {{item}}
    </view>
  </view>

  <view class="order-list">
    <view class="order-card" wx:for="{{orders}}" wx:key="id" bindtap="onOrderTap" data-id="{{item.id}}">
      <view class="order-header">
        <view class="order-no">订单号: {{item.orderNo}}</view>
        <view class="order-status {{item.statusClass}}">{{item.status}}</view>
      </view>
      <view class="order-content">
        <image class="item-image" src="{{item.itemImage}}" mode="aspectFill" />
        <view class="item-info">
          <view class="item-title">{{item.itemTitle}}</view>
          <view class="item-type {{item.typeClass}}">{{item.type}}</view>
        </view>
      </view>
      <view class="order-footer">
        <view class="order-time">{{item.createTime}}</view>
        <view class="order-amount">¥{{item.amount}}</view>
      </view>
    </view>

    <view class="empty" wx:if="{{orders.length === 0}}">
      <text class="empty-icon">📦</text>
      <text class="empty-text">暂无订单</text>
    </view>
  </view>
</view>
