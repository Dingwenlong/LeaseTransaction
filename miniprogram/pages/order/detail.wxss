.container {
  min-height: 100vh;
  background: #0f172a;
  padding-bottom: 160rpx;
}

.status-section {
  background: linear-gradient(135deg, #1e1b4b, #0f172a);
  padding: 60rpx 30rpx;
  text-align: center;
}

.status-icon {
  font-size: 100rpx;
  color: #22c55e;
  margin-bottom: 20rpx;
}

.status-text {
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
}

.status-desc {
  color: #94a3b8;
  font-size: 26rpx;
}

.info-section,
.item-section,
.price-section {
  background: rgba(30, 41, 59, 0.9);
  margin: 20rpx;
  padding: 30rpx;
  border: 2rpx solid #334155;
  border-radius: 16rpx;
  box-shadow: 4rpx 4rpx 0px rgba(51, 65, 85, 0.5);
}

.section-title {
  color: #22d3ee;
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
}

.info-row,
.price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #334155;
}

.info-row:last-child,
.price-row:last-child {
  border-bottom: none;
}

.label {
  color: #94a3b8;
  font-size: 28rpx;
}

.value {
  color: #cbd5e1;
  font-size: 28rpx;
}

.item-card {
  display: flex;
  gap: 20rpx;
}

.item-image {
  width: 160rpx;
  height: 160rpx;
  background: #1e293b;
  border-radius: 12rpx;
}

.item-info {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}

.item-title {
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
}

.item-type {
  align-self: flex-start;
  padding: 6rpx 16rpx;
  border-radius: 6rpx;
  font-size: 20rpx;
  font-weight: bold;
}

.item-type.lease {
  background: rgba(34, 211, 238, 0.2);
  color: #22d3ee;
  border: 1rpx solid #22d3ee;
}

.item-type.sale {
  background: rgba(236, 72, 153, 0.2);
  color: #ec4899;
  border: 1rpx solid #ec4899;
}

.total-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding-top: 20rpx;
  margin-top: 20rpx;
  border-top: 2rpx solid #334155;
}

.total {
  color: #fbbf24;
  font-size: 36rpx;
  font-weight: bold;
}

.action-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  gap: 20rpx;
  padding: 20rpx 30rpx;
  background: #0f172a;
  border-top: 2rpx solid #334155;
}

.btn {
  flex: 1;
  height: 90rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: bold;
}

.btn.secondary {
  background: rgba(30, 41, 59, 0.9);
  border: 2rpx solid #64748b;
  color: #cbd5e1;
}

.btn.primary {
  background: linear-gradient(90deg, #ec4899, #a855f7);
  border: 2rpx solid #fff;
  color: #fff;
  box-shadow: 4rpx 4rpx 0px #fff;
}
