.order-detail-page {
  padding-bottom: 0;
}

.order-detail-hero {
  align-items: center;
  text-align: center;
}

.order-detail-status-icon {
  font-size: 88rpx;
  line-height: 1;
}

.order-detail-title {
  margin-top: 12rpx;
}

.order-detail-subtitle {
  margin-top: 12rpx;
}

.order-detail-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 24rpx;
}

.order-detail-row,
.order-detail-total {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 18rpx;
  min-width: 0;
}

.order-detail-row {
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid rgba(148, 163, 184, 0.1);
}

.order-detail-label {
  color: #94a3b8;
  font-size: 26rpx;
}

.order-detail-value {
  flex: 1;
  color: #e2e8f0;
  font-size: 26rpx;
  line-height: 1.6;
  text-align: right;
}

.order-detail-item {
  display: flex;
  gap: 18rpx;
  min-width: 0;
  margin-top: 24rpx;
}

.order-detail-image {
  width: 170rpx;
  height: 170rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
  background: #13233d;
}

.order-detail-item-copy {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  gap: 14rpx;
}

.order-detail-item-title {
  color: #ffffff;
  font-size: 30rpx;
  line-height: 1.55;
  font-weight: 700;
  word-break: break-word;
}

.order-detail-total {
  padding-top: 10rpx;
}

.order-detail-total-value {
  color: #fde047;
  font-size: 40rpx;
  font-weight: 800;
}

@media (max-width: 360px) {
  .order-detail-row,
  .order-detail-total {
    flex-direction: column;
  }

  .order-detail-value {
    text-align: left;
  }

  .order-detail-item {
    flex-direction: column;
  }

  .order-detail-image {
    width: 100%;
    height: 280rpx;
  }
}
