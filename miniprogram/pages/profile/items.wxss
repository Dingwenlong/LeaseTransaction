.order-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.order-card-body {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.order-card-main {
  display: flex;
  gap: 18rpx;
  min-width: 0;
}

.order-card-image {
  width: 160rpx;
  height: 160rpx;
  flex-shrink: 0;
  border-radius: 24rpx;
  background: #13233d;
}

.order-card-info {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.order-card-title {
  color: #ffffff;
  font-size: 30rpx;
  line-height: 1.5;
  font-weight: 700;
  word-break: break-word;
}

.order-card-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.order-card-time {
  color: #94a3b8;
  font-size: 22rpx;
}

.order-card-amount {
  margin-top: 8rpx;
  color: #fde047;
  font-size: 34rpx;
  font-weight: 800;
}

.profile-item-hint {
  color: #94a3b8;
  font-size: 22rpx;
  line-height: 1.6;
}

.profile-inline-btn {
  width: auto;
  min-width: 160rpx;
  height: 72rpx;
  padding: 0 24rpx;
}

@media (max-width: 360px) {
  .order-card-main,
  .order-card-foot {
    flex-direction: column;
    align-items: flex-start;
  }

  .order-card-image {
    width: 100%;
    height: 280rpx;
  }
}
