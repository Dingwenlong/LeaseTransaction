.profile-hero {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.profile-head {
  display: flex;
  align-items: center;
  gap: 20rpx;
  min-width: 0;
}

.profile-avatar-wrap {
  flex-shrink: 0;
}

.profile-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 36rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  background: rgba(15, 23, 42, 0.72);
}

.profile-avatar-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #67e8f9;
  font-size: 52rpx;
}

.profile-copy {
  flex: 1;
  min-width: 0;
}

.profile-name {
  margin-top: 14rpx;
  color: #ffffff;
  font-size: 40rpx;
  font-weight: 800;
}

.profile-id {
  margin-top: 10rpx;
  color: #cbd5e1;
  font-size: 24rpx;
}

.profile-credit {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
  padding: 26rpx;
  border-radius: 28rpx;
  background: rgba(15, 23, 42, 0.54);
  border: 1rpx solid rgba(148, 163, 184, 0.14);
}

.profile-credit-label {
  color: #94a3b8;
  font-size: 22rpx;
}

.profile-credit-value {
  margin-top: 8rpx;
  color: #fde047;
  font-size: 54rpx;
  line-height: 1;
  font-weight: 800;
}

.profile-credit-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 12rpx;
}

.profile-credit-meta {
  color: #94a3b8;
  font-size: 22rpx;
  text-align: right;
}

.profile-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18rpx;
}

.profile-stat-card {
  padding: 28rpx 18rpx;
  text-align: center;
}

.profile-stat-value {
  color: #67e8f9;
  font-size: 40rpx;
  font-weight: 800;
}

.profile-stat-label {
  margin-top: 10rpx;
  color: #94a3b8;
  font-size: 22rpx;
}

.profile-menu {
  display: flex;
  flex-direction: column;
  margin-top: 24rpx;
}

.profile-menu-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-width: 0;
  padding: 24rpx 0;
  border-bottom: 1rpx solid rgba(148, 163, 184, 0.08);
}

.profile-menu-item:last-child {
  border-bottom: none;
}

.profile-menu-icon {
  width: 64rpx;
  height: 64rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 20rpx;
  background: rgba(148, 163, 184, 0.08);
  font-size: 30rpx;
}

.profile-menu-text {
  flex: 1;
  min-width: 0;
  color: #e2e8f0;
  font-size: 28rpx;
}

.profile-menu-arrow {
  flex-shrink: 0;
  color: #64748b;
  font-size: 34rpx;
}

.profile-action {
  margin-top: 8rpx;
}

.profile-stats + .profile-stats {
  margin-top: -6rpx;
}

.profile-review-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 24rpx;
}

.profile-review-item {
  padding: 24rpx;
  border-radius: 24rpx;
  background: rgba(15, 23, 42, 0.48);
  border: 1rpx solid rgba(148, 163, 184, 0.12);
}

.profile-review-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
}

.profile-review-name {
  color: #f8fafc;
  font-size: 28rpx;
  font-weight: 700;
}

.profile-review-rating {
  color: #fde047;
  font-size: 24rpx;
}

.profile-review-meta {
  margin-top: 10rpx;
  color: #94a3b8;
  font-size: 22rpx;
}

.profile-review-content {
  margin-top: 14rpx;
  color: #e2e8f0;
  font-size: 26rpx;
  line-height: 1.7;
}

@media (max-width: 360px) {
  .profile-head,
  .profile-credit {
    flex-direction: column;
    align-items: flex-start;
  }

  .profile-credit-side {
    align-items: flex-start;
  }

  .profile-credit-meta {
    text-align: left;
  }

  .profile-stats {
    grid-template-columns: 1fr;
  }
}
