.profile-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18rpx;
}

.profile-stat-card {
  padding: 28rpx 18rpx;
  text-align: center;
}

.profile-stat-value {
  color: #67e8f9;
  font-size: 34rpx;
  font-weight: 800;
}

.profile-stat-label {
  margin-top: 10rpx;
  color: #94a3b8;
  font-size: 22rpx;
}

.wallet-record-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 24rpx;
}

.wallet-record-item {
  display: flex;
  justify-content: space-between;
  gap: 18rpx;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(148, 163, 184, 0.1);
}

.wallet-record-item:last-child {
  border-bottom: none;
}

.wallet-record-title {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.wallet-record-meta,
.wallet-record-status {
  margin-top: 10rpx;
  color: #94a3b8;
  font-size: 22rpx;
}

.wallet-record-side {
  text-align: right;
}

.wallet-record-amount {
  color: #fde047;
  font-size: 30rpx;
  font-weight: 800;
}

@media (max-width: 360px) {
  .profile-stats {
    grid-template-columns: 1fr;
  }

  .wallet-record-item {
    flex-direction: column;
  }

  .wallet-record-side {
    text-align: left;
  }
}
