.login-page {
  display: flex;
  align-items: center;
  justify-content: center;
  padding-top: 60rpx;
  padding-bottom: 60rpx;
}

.login-shell {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.login-panel {
  width: 100%;
}

.login-form {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-top: 24rpx;
}

.login-field {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
}

.login-label {
  color: #e2e8f0;
  font-size: 26rpx;
  font-weight: 700;
}

.login-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 24rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.18);
  background: rgba(15, 23, 42, 0.76);
  color: #ffffff;
  font-size: 28rpx;
}

.login-input::placeholder {
  color: #64748b;
}

.login-submit {
  margin-top: 8rpx;
}

.login-footer {
  text-align: center;
  font-size: 24rpx;
}

.login-footer-text {
  color: #64748b;
}

.login-footer-link {
  color: #67e8f9;
  margin: 0 10rpx;
}
