.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #0f172a 0%, #1e1b4b 50%, #0f172a 100%);
  padding: 80rpx 60rpx;
  box-sizing: border-box;
}

.header {
  text-align: center;
  margin-bottom: 120rpx;
}

.logo {
  margin-bottom: 20rpx;
}

.logo-text {
  font-size: 48rpx;
  font-weight: bold;
  background: linear-gradient(90deg, #22d3ee, #ec4899, #a855f7);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.subtitle {
  font-size: 28rpx;
  color: #94a3b8;
}

.form {
  margin-bottom: 100rpx;
}

.form-item {
  margin-bottom: 40rpx;
}

.input {
  width: 100%;
  height: 100rpx;
  background: rgba(30, 41, 59, 0.8);
  border: 3rpx solid #22d3ee;
  border-radius: 10rpx;
  padding: 0 30rpx;
  box-sizing: border-box;
  color: #fff;
  font-size: 32rpx;
  box-shadow: 4rpx 4rpx 0px rgba(34, 211, 238, 0.3);
}

.input::placeholder {
  color: #64748b;
}

.login-btn {
  width: 100%;
  height: 100rpx;
  background: linear-gradient(90deg, #ec4899, #a855f7);
  border: 3rpx solid #fff;
  border-radius: 10rpx;
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
  box-shadow: 4rpx 4px 0px #fff;
  margin-top: 40rpx;
}

.login-btn:active {
  transform: translate(2rpx, 2rpx);
  box-shadow: 2rpx 2rpx 0px #fff;
}

.footer {
  text-align: center;
  font-size: 24rpx;
}

.footer-text {
  color: #64748b;
}

.link {
  color: #22d3ee;
  margin: 0 10rpx;
}
