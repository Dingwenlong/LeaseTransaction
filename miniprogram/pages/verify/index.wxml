<view class="mp-page verify-page">
  <view class="mp-shell">
    <view class="mp-hero">
      <view class="mp-eyebrow">Verify</view>
      <view class="mp-title">完成校园身份核验</view>
      <view class="mp-subtitle">认证后可解锁更多交易能力，并为信用免押和附近推荐提供基础数据。</view>
    </view>

    <view class="mp-panel">
      <view class="mp-panel-body">
        <view class="mp-section-head">
          <view>
            <view class="mp-section-title">认证信息</view>
            <view class="mp-section-desc">请填写学号、院系和校区信息，系统将标记为已认证用户。</view>
          </view>
        </view>

        <view class="verify-form">
          <view class="verify-field">
            <view class="verify-label">学号</view>
            <input class="verify-input" placeholder="请输入学号" value="{{form.studentId}}" bindinput="onInput" data-field="studentId" />
          </view>
          <view class="verify-field">
            <view class="verify-label">院系</view>
            <input class="verify-input" placeholder="请输入院系名称" value="{{form.department}}" bindinput="onInput" data-field="department" />
          </view>
          <view class="verify-field">
            <view class="verify-label">校区</view>
            <picker mode="selector" range="{{campuses}}" bindchange="onCampusChange">
              <view class="verify-input verify-picker">{{form.campus || '请选择校区'}}</view>
            </picker>
          </view>
        </view>
      </view>
    </view>
  </view>

  <view class="mp-fixed-spacer"></view>
  <view class="mp-fixed-bar">
    <view class="mp-secondary-btn" bindtap="handleSkip">稍后再说</view>
    <view class="mp-primary-btn" bindtap="handleSubmit">提交认证</view>
  </view>
</view>
