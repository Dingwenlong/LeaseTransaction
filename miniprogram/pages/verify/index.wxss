.verify-page {
  padding-bottom: 0;
}

.verify-form {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
  margin-top: 24rpx;
}

.verify-field {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.verify-label {
  color: #e2e8f0;
  font-size: 26rpx;
  font-weight: 700;
}

.verify-input {
  width: 100%;
  min-height: 88rpx;
  padding: 0 24rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  color: #ffffff;
  background: rgba(15, 23, 42, 0.76);
  font-size: 28rpx;
}

.verify-picker {
  color: #cbd5e1;
}
