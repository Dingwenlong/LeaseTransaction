.publish-page {
  padding-bottom: 0;
}

.publish-form {
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  margin-top: 24rpx;
}

.publish-field {
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  min-width: 0;
}

.publish-label {
  color: #e2e8f0;
  font-size: 26rpx;
  font-weight: 700;
}

.publish-image-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 18rpx;
  min-width: 0;
}

.publish-image-item,
.publish-image-add {
  position: relative;
  width: 100%;
  aspect-ratio: 1;
  border-radius: 24rpx;
  overflow: hidden;
}

.publish-image-item {
  background: #13233d;
}

.publish-image {
  width: 100%;
  height: 100%;
}

.publish-image-delete {
  position: absolute;
  top: 10rpx;
  right: 10rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(244, 63, 94, 0.92);
  color: #ffffff;
  font-size: 28rpx;
}

.publish-image-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  border: 1rpx dashed rgba(148, 163, 184, 0.26);
  background: rgba(15, 23, 42, 0.74);
}

.publish-image-add-icon {
  color: #67e8f9;
  font-size: 42rpx;
}

.publish-image-add-text {
  color: #94a3b8;
  font-size: 22rpx;
}

.publish-tip {
  color: #64748b;
  font-size: 22rpx;
}

.publish-input,
.publish-picker,
.publish-textarea {
  width: 100%;
  min-width: 0;
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  border-radius: 24rpx;
  background: rgba(15, 23, 42, 0.76);
  color: #ffffff;
}

.publish-input,
.publish-picker {
  height: 88rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  display: flex;
  align-items: center;
}

.publish-picker-text {
  color: #cbd5e1;
  font-size: 28rpx;
}

.publish-textarea {
  min-height: 220rpx;
  padding: 22rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.7;
}

.publish-type-grid,
.publish-inline-grid {
  display: grid;
  gap: 18rpx;
  min-width: 0;
}

.publish-type-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.publish-inline-grid {
  grid-template-columns: repeat(2, minmax(0, 1fr));
}

.publish-type-item {
  min-width: 0;
  min-height: 184rpx;
  padding: 24rpx 20rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  border-radius: 28rpx;
  background: rgba(15, 23, 42, 0.72);
  display: flex;
  flex-direction: column;
  justify-content: center;
  gap: 8rpx;
}

.publish-type-item.is-active {
  border-color: rgba(34, 211, 238, 0.34);
  background: linear-gradient(135deg, rgba(34, 211, 238, 0.18), rgba(236, 72, 153, 0.12));
  box-shadow: 0 14rpx 28rpx rgba(34, 211, 238, 0.14);
}

.publish-type-icon {
  font-size: 40rpx;
}

.publish-type-text {
  color: #ffffff;
  font-size: 28rpx;
  font-weight: 700;
}

.publish-type-subtext {
  color: #94a3b8;
  font-size: 22rpx;
}

.publish-count {
  text-align: right;
  color: #64748b;
  font-size: 22rpx;
}

@media (max-width: 360px) {
  .publish-image-grid,
  .publish-type-grid,
  .publish-inline-grid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}
