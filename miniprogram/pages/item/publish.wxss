.container {
  min-height: 100vh;
  background: #0f172a;
  padding: 30rpx;
  padding-bottom: 150rpx;
}

.form-section {
  background: rgba(30, 41, 59, 0.9);
  border: 2rpx solid #334155;
  border-radius: 16rpx;
  padding: 40rpx 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 4rpx 4rpx 0px rgba(51, 65, 85, 0.5);
}

.section-title {
  color: #22d3ee;
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
}

.form-item {
  margin-bottom: 30rpx;
}

.form-item:last-child {
  margin-bottom: 0;
}

.label {
  color: #cbd5e1;
  font-size: 28rpx;
  margin-bottom: 16rpx;
}

.image-upload {
  width: 100%;
}

.image-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
}

.image-item {
  position: relative;
  width: 100%;
  aspect-ratio: 1;
  background: #1e293b;
  border-radius: 12rpx;
  overflow: hidden;
}

.image-item .image {
  width: 100%;
  height: 100%;
}

.image-delete {
  position: absolute;
  top: 8rpx;
  right: 8rpx;
  width: 40rpx;
  height: 40rpx;
  background: rgba(239, 68, 68, 0.9);
  color: #fff;
  font-size: 32rpx;
  line-height: 40rpx;
  text-align: center;
  border-radius: 50%;
}

.image-add {
  width: 100%;
  aspect-ratio: 1;
  background: #1e293b;
  border: 2rpx dashed #475569;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
}

.add-icon {
  font-size: 48rpx;
  color: #64748b;
}

.add-text {
  font-size: 22rpx;
  color: #64748b;
}

.image-tip {
  color: #64748b;
  font-size: 22rpx;
  margin-top: 16rpx;
}

.input {
  width: 100%;
  height: 90rpx;
  background: #0f172a;
  border: 2rpx solid #475569;
  border-radius: 10rpx;
  padding: 0 24rpx;
  box-sizing: border-box;
  color: #fff;
  font-size: 28rpx;
}

.input:focus {
  border-color: #22d3ee;
}

.type-selector {
  display: flex;
  gap: 20rpx;
}

.type-option {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 140rpx;
  background: #0f172a;
  border: 2rpx solid #475569;
  border-radius: 12rpx;
  gap: 10rpx;
}

.type-option.active {
  border-color: #22d3ee;
  background: rgba(34, 211, 238, 0.1);
  box-shadow: 0 0 20rpx rgba(34, 211, 238, 0.3);
}

.type-icon {
  font-size: 40rpx;
}

.type-text {
  color: #cbd5e1;
  font-size: 26rpx;
  font-weight: bold;
}

.type-option.active .type-text {
  color: #22d3ee;
}

.picker {
  width: 100%;
  height: 90rpx;
  background: #0f172a;
  border: 2rpx solid #475569;
  border-radius: 10rpx;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.picker-text {
  color: #cbd5e1;
  font-size: 28rpx;
}

.textarea {
  width: 100%;
  min-height: 200rpx;
  background: #0f172a;
  border: 2rpx solid #475569;
  border-radius: 10rpx;
  padding: 20rpx 24rpx;
  box-sizing: border-box;
  color: #fff;
  font-size: 28rpx;
  line-height: 1.6;
}

.char-count {
  text-align: right;
  color: #64748b;
  font-size: 22rpx;
  margin-top: 10rpx;
}

.submit-btn {
  position: fixed;
  bottom: 30rpx;
  left: 30rpx;
  right: 30rpx;
  height: 100rpx;
  background: linear-gradient(90deg, #ec4899, #a855f7);
  border: 2rpx solid #fff;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 4rpx 4rpx 0px #fff;
  z-index: 100;
}

.btn-text {
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
}
