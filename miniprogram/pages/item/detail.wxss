.detail-page {
  padding-bottom: 0;
}

.detail-cover {
  width: 100%;
  height: 600rpx;
  background: #13233d;
}

.detail-summary {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.detail-heading {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 18rpx;
  min-width: 0;
}

.detail-heading-copy {
  flex: 1;
  min-width: 0;
}

.detail-title {
  color: #ffffff;
  font-size: 40rpx;
  line-height: 1.3;
  font-weight: 800;
  word-break: break-word;
}

.detail-subtitle {
  margin-top: 12rpx;
  color: #94a3b8;
  font-size: 24rpx;
}

.detail-price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}

.detail-price-block {
  display: flex;
  align-items: baseline;
  min-width: 0;
}

.detail-price-symbol {
  color: #fde047;
  font-size: 28rpx;
  font-weight: 700;
}

.detail-price-value {
  color: #fde047;
  font-size: 58rpx;
  font-weight: 800;
  line-height: 1;
}

.detail-price-unit {
  margin-left: 8rpx;
  color: #94a3b8;
  font-size: 24rpx;
}

.detail-description {
  margin-top: 22rpx;
  color: #cbd5e1;
  font-size: 28rpx;
  line-height: 1.9;
  word-break: break-word;
}

@media (max-width: 360px) {
  .detail-heading,
  .detail-price-row {
    flex-direction: column;
    align-items: flex-start;
  }

  .detail-cover {
    height: 500rpx;
  }
}
