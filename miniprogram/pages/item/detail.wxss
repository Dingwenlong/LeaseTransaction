.container {
  min-height: 100vh;
  background: #0f172a;
  padding-bottom: 140rpx;
}

.image-section {
  width: 100%;
  height: 600rpx;
  background: #1e293b;
}

.main-image {
  width: 100%;
  height: 100%;
}

.info-section {
  padding: 40rpx 30rpx;
  background: rgba(30, 41, 59, 0.8);
  border-bottom: 2rpx solid #334155;
}

.title-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.title {
  flex: 1;
  color: #fff;
  font-size: 36rpx;
  font-weight: bold;
  margin-right: 20rpx;
}

.type-badge {
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  font-size: 24rpx;
  font-weight: bold;
}

.type-badge.lease {
  background: rgba(34, 211, 238, 0.2);
  color: #22d3ee;
  border: 2rpx solid #22d3ee;
}

.type-badge.sale {
  background: rgba(236, 72, 153, 0.2);
  color: #ec4899;
  border: 2rpx solid #ec4899;
}

.price-row {
  display: flex;
  align-items: baseline;
  margin-bottom: 20rpx;
}

.price-symbol {
  color: #fbbf24;
  font-size: 28rpx;
  font-weight: bold;
}

.price-value {
  color: #fbbf24;
  font-size: 48rpx;
  font-weight: bold;
  margin-right: 10rpx;
}

.price-unit {
  color: #94a3b8;
  font-size: 24rpx;
}

.meta-row {
  display: flex;
  gap: 30rpx;
}

.meta {
  color: #94a3b8;
  font-size: 26rpx;
}

.description-section {
  padding: 40rpx 30rpx;
}

.section-title {
  color: #22d3ee;
  font-size: 28rpx;
  font-weight: bold;
  margin-bottom: 20rpx;
}

.description {
  color: #cbd5e1;
  font-size: 28rpx;
  line-height: 1.8;
}

.bottom-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  display: flex;
  padding: 20rpx 30rpx;
  background: #0f172a;
  border-top: 2rpx solid #334155;
  gap: 20rpx;
}

.contact-btn {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  height: 100rpx;
  background: rgba(30, 41, 59, 0.9);
  border: 2rpx solid #22d3ee;
  border-radius: 12rpx;
}

.btn-icon {
  font-size: 32rpx;
}

.btn-text {
  color: #22d3ee;
  font-size: 28rpx;
  font-weight: bold;
}

.action-btn {
  flex: 2;
  display: flex;
  align-items: center;
  justify-content: center;
  height: 100rpx;
  background: linear-gradient(90deg, #ec4899, #a855f7);
  border: 2rpx solid #fff;
  border-radius: 12rpx;
  box-shadow: 4rpx 4rpx 0px #fff;
}

.action-btn .btn-text {
  color: #fff;
  font-size: 32rpx;
}
