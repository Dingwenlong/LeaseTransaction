.detail-page {
  padding-bottom: 0;
}

.detail-swiper {
  width: 100%;
  height: 600rpx;
}

.detail-cover {
  width: 100%;
  height: 100%;
  background: #13233d;
}

.detail-summary {
  display: flex;
  flex-direction: column;
  gap: 22rpx;
}

.detail-heading {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 18rpx;
  min-width: 0;
}

.detail-heading-copy {
  flex: 1;
  min-width: 0;
}

.detail-title {
  color: #ffffff;
  font-size: 40rpx;
  line-height: 1.3;
  font-weight: 800;
  word-break: break-word;
}

.detail-subtitle {
  margin-top: 12rpx;
  color: #94a3b8;
  font-size: 24rpx;
}

.detail-price-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
}

.detail-price-block {
  display: flex;
  align-items: baseline;
  min-width: 0;
}

.detail-price-symbol {
  color: #fde047;
  font-size: 28rpx;
  font-weight: 700;
}

.detail-price-value {
  color: #fde047;
  font-size: 58rpx;
  font-weight: 800;
  line-height: 1;
}

.detail-price-unit {
  margin-left: 8rpx;
  color: #94a3b8;
  font-size: 24rpx;
}

.detail-info-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
  margin-top: 24rpx;
}

.detail-info-row {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 18rpx;
  padding-bottom: 18rpx;
  border-bottom: 1rpx solid rgba(148, 163, 184, 0.1);
}

.detail-info-row:last-child {
  padding-bottom: 0;
  border-bottom: none;
}

.detail-info-label {
  color: #94a3b8;
  font-size: 24rpx;
}

.detail-info-value {
  flex: 1;
  color: #e2e8f0;
  font-size: 24rpx;
  line-height: 1.7;
  text-align: right;
}

.detail-description {
  margin-top: 22rpx;
  color: #cbd5e1;
  font-size: 28rpx;
  line-height: 1.9;
  word-break: break-word;
}

.detail-owner-card {
  cursor: pointer;
}

.detail-owner-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 18rpx;
  margin-top: 22rpx;
}

.detail-owner-name {
  color: #f8fafc;
  font-size: 30rpx;
  font-weight: 700;
}

.detail-owner-meta {
  margin-top: 10rpx;
  color: #94a3b8;
  font-size: 24rpx;
}

.detail-owner-arrow {
  color: #64748b;
  font-size: 36rpx;
}

@media (max-width: 360px) {
  .detail-heading,
  .detail-price-row,
  .detail-info-row,
  .detail-owner-row {
    flex-direction: column;
    align-items: flex-start;
  }

  .detail-cover,
  .detail-swiper {
    height: 500rpx;
  }

  .detail-info-value {
    text-align: left;
  }
}
