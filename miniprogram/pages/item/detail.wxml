<view class="mp-page detail-page" wx:if="{{item}}">
  <view class="mp-shell">
    <view class="mp-panel">
      <swiper class="detail-swiper" indicator-dots circular>
        <swiper-item wx:for="{{item.images}}" wx:key="index">
          <image class="detail-cover" src="{{item}}" mode="aspectFill" />
        </swiper-item>
      </swiper>
    </view>

    <view class="mp-panel">
      <view class="mp-panel-body detail-summary">
        <view class="detail-heading">
          <view class="detail-heading-copy">
            <view class="detail-title">{{item.title}}</view>
            <view class="detail-subtitle">{{item.ownerName}} · {{item.campus}}</view>
          </view>
          <view class="mp-tag {{item.typeClass === 'lease' ? 'mp-tag-cyan' : 'mp-tag-magenta'}}">
            {{item.typeText}}
          </view>
        </view>

        <view class="detail-price-row">
          <view class="detail-price-block">
            <text class="detail-price-symbol">¥</text>
            <text class="detail-price-value">{{item.price}}</text>
            <text class="detail-price-unit" wx:if="{{item.type === 1}}">/天</text>
          </view>
          <view class="mp-meta-pill">{{item.statusText}}</view>
        </view>

        <view class="mp-meta-row">
          <view class="mp-meta-pill">📍 {{item.campus}}</view>
          <view class="mp-meta-pill">👁 {{item.viewCount}}</view>
          <view class="mp-meta-pill">❤️ {{item.favoriteCount}}</view>
          <view class="mp-tag mp-tag-green" wx:if="{{item.ownerVerified}}">校园认证</view>
        </view>
      </view>
    </view>

    <view class="mp-panel">
      <view class="mp-panel-body detail-owner-card" bindtap="goToOwnerProfile">
        <view class="mp-section-head">
          <view>
            <view class="mp-section-title">发布者信誉</view>
            <view class="mp-section-desc">高信誉用户物品会获得更多曝光。</view>
          </view>
          <view class="detail-owner-arrow">›</view>
        </view>
        <view class="detail-owner-row">
          <view>
            <view class="detail-owner-name">{{item.ownerName}}</view>
            <view class="detail-owner-meta">信用 {{item.ownerCreditScore}} · {{item.ownerCreditLevel}}</view>
          </view>
          <view class="mp-tag {{item.ownerCreditScore >= 90 ? 'mp-tag-green' : item.ownerCreditScore >= 70 ? 'mp-tag-yellow' : 'mp-tag-slate'}}">
            {{item.ownerCreditLevel}}
          </view>
        </view>
      </view>
    </view>

    <view class="mp-panel">
      <view class="mp-panel-body">
        <view class="mp-section-head">
          <view>
            <view class="mp-section-title">交易信息</view>
            <view class="mp-section-desc">租赁支持押金和预约时间，出售支持直接下单。</view>
          </view>
        </view>
        <view class="detail-info-list">
          <view class="detail-info-row">
            <text class="detail-info-label">交易模式</text>
            <text class="detail-info-value">{{item.typeText}}</text>
          </view>
          <view class="detail-info-row">
            <text class="detail-info-label">押金</text>
            <text class="detail-info-value">{{item.depositText}}</text>
          </view>
          <view class="detail-info-row">
            <text class="detail-info-label">履约提示</text>
            <text class="detail-info-value">{{item.reviewHint}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="mp-panel">
      <view class="mp-panel-body">
        <view class="mp-section-head">
          <view>
            <view class="mp-section-title">物品描述</view>
            <view class="mp-section-desc">描述区保持完整换行，便于查看成色和交接方式。</view>
          </view>
        </view>
        <view class="detail-description">{{item.description}}</view>
      </view>
    </view>
  </view>

  <view class="mp-fixed-spacer"></view>
  <view class="mp-fixed-bar">
    <view class="mp-secondary-btn" bindtap="handleContact">{{isOwner ? '查看我的发布' : '联系发布者'}}</view>
    <view class="mp-primary-btn" bindtap="handleRent">
      {{isOwner ? '管理物品' : item.type === 1 ? '立即租赁' : '立即购买'}}
    </view>
  </view>
</view>
