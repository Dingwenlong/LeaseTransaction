<view class="mp-page message-page">
  <view class="mp-shell">
    <view class="mp-hero">
      <view class="mp-eyebrow">Inbox</view>
      <view class="mp-title">消息中心</view>
      <view class="mp-subtitle">查看订单消息、聊天提醒和系统通知。</view>
      <view class="mp-chip-row message-tabs">
        <view
          wx:for="{{tabs}}"
          wx:key="index"
          class="mp-chip {{activeTab === index ? 'mp-chip-active' : ''}}"
          bindtap="onTabTap"
          data-index="{{index}}"
        >
          {{item.name}}
          <text class="message-tab-badge" wx:if="{{item.count > 0}}">{{item.count}}</text>
        </view>
      </view>
    </view>

    <view class="message-list">
      <view
        wx:for="{{displayMessages}}"
        wx:key="id"
        class="mp-panel message-card"
        bindtap="onMessageTap"
        data-id="{{item.id}}"
      >
        <view class="mp-panel-body message-card-body">
          <view class="message-icon">{{item.icon}}</view>
          <view class="message-copy">
            <view class="message-head">
              <text class="message-title mp-ellipsis">{{item.title}}</text>
              <text class="message-time">{{item.time}}</text>
            </view>
            <view class="message-desc">{{item.desc}}</view>
          </view>
          <view class="message-dot" wx:if="{{!item.read}}"></view>
        </view>
      </view>

      <view class="mp-empty" wx:if="{{displayMessages.length === 0}}">
        <text class="mp-empty-icon">📭</text>
        <text class="mp-empty-title">暂无消息</text>
        <text class="mp-empty-text">新的订单和系统提醒会在这里显示。</text>
      </view>
    </view>
  </view>
</view>
