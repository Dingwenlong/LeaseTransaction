<view class="container">
  <view class="tabs">
    <view class="tab {{activeTab === 0 ? 'active' : ''}}" wx:for="{{tabs}}" wx:key="index" bindtap="onTabTap" data-index="{{index}}">
      {{item.name}}
      <view class="badge" wx:if="{{item.count > 0}}">{{item.count}}</view>
    </view>
  </view>

  <view class="message-list">
    <view class="message-card" wx:for="{{messages}}" wx:key="id" bindtap="onMessageTap" data-id="{{item.id}}">
      <view class="message-icon">{{item.icon}}</view>
      <view class="message-content">
        <view class="message-header">
          <text class="message-title">{{item.title}}</text>
          <text class="message-time">{{item.time}}</text>
        </view>
        <view class="message-desc">{{item.desc}}</view>
      </view>
      <view class="message-dot" wx:if="{{!item.read}}"></view>
    </view>

    <view class="empty" wx:if="{{messages.length === 0}}">
      <text class="empty-icon">📭</text>
      <text class="empty-text">暂无消息</text>
    </view>
  </view>
</view>
