.container {
  min-height: 100vh;
  background: #0f172a;
}

.tabs {
  display: flex;
  background: rgba(30, 41, 59, 0.9);
  border-bottom: 2rpx solid #334155;
  padding: 20rpx 0;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  color: #94a3b8;
  font-size: 28rpx;
  position: relative;
}

.tab.active {
  color: #22d3ee;
  font-weight: bold;
}

.tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 60rpx;
  height: 4rpx;
  background: linear-gradient(90deg, #22d3ee, #ec4899);
  border-radius: 2rpx;
}

.badge {
  position: absolute;
  top: 10rpx;
  right: 40rpx;
  min-width: 32rpx;
  height: 32rpx;
  background: #ef4444;
  color: #fff;
  font-size: 20rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 8rpx;
}

.message-list {
  padding: 20rpx;
}

.message-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  background: rgba(30, 41, 59, 0.9);
  border: 2rpx solid #334155;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  position: relative;
  box-shadow: 4rpx 4rpx 0px rgba(51, 65, 85, 0.5);
}

.message-icon {
  width: 100rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #22d3ee, #0891b2);
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  flex-shrink: 0;
}

.message-content {
  flex: 1;
  overflow: hidden;
}

.message-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 10rpx;
}

.message-title {
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
}

.message-time {
  color: #64748b;
  font-size: 22rpx;
  flex-shrink: 0;
  margin-left: 20rpx;
}

.message-desc {
  color: #94a3b8;
  font-size: 24rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.message-dot {
  width: 16rpx;
  height: 16rpx;
  background: #ef4444;
  border-radius: 50%;
  flex-shrink: 0;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  color: #64748b;
  font-size: 28rpx;
}
