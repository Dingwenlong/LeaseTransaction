page {
  min-height: 100%;
  background: linear-gradient(180deg, #081120 0%, #0c1830 48%, #07111f 100%);
  color: #e2e8f0;
  font-family: "PingFang SC", "Microsoft YaHei", sans-serif;
}

view,
text,
button,
input,
textarea,
picker,
image,
scroll-view {
  box-sizing: border-box;
}

button {
  margin: 0;
  padding: 0;
  line-height: 1;
  background: transparent;
}

button::after {
  border: none;
}

image {
  display: block;
}

.mp-page {
  min-height: 100vh;
  padding: 24rpx;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.mp-shell {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  min-width: 0;
}

.mp-panel {
  overflow: hidden;
  border: 1rpx solid rgba(148, 163, 184, 0.18);
  border-radius: 30rpx;
  background: rgba(9, 17, 33, 0.84);
  box-shadow: 0 20rpx 60rpx rgba(2, 8, 23, 0.24);
}

.mp-panel-body {
  padding: 30rpx;
  min-width: 0;
}

.mp-hero {
  padding: 36rpx 30rpx;
  border-radius: 36rpx;
  border: 1rpx solid rgba(34, 211, 238, 0.2);
  background: linear-gradient(135deg, rgba(34, 211, 238, 0.14), rgba(236, 72, 153, 0.14) 58%, rgba(8, 17, 32, 0.94));
  box-shadow: 0 20rpx 60rpx rgba(34, 211, 238, 0.14);
}

.mp-eyebrow {
  color: #67e8f9;
  font-size: 20rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  text-transform: uppercase;
}

.mp-title {
  margin-top: 16rpx;
  color: #ffffff;
  font-size: 50rpx;
  line-height: 1.16;
  font-weight: 800;
}

.mp-subtitle {
  margin-top: 18rpx;
  color: #cbd5e1;
  font-size: 26rpx;
  line-height: 1.7;
}

.mp-section-head {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 20rpx;
  min-width: 0;
}

.mp-section-title {
  color: #ffffff;
  font-size: 32rpx;
  font-weight: 700;
}

.mp-section-desc {
  margin-top: 10rpx;
  color: #94a3b8;
  font-size: 24rpx;
  line-height: 1.6;
}

.mp-search {
  display: flex;
  align-items: center;
  gap: 16rpx;
  min-width: 0;
  padding: 14rpx 16rpx 14rpx 24rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  border-radius: 999rpx;
  background: rgba(15, 23, 42, 0.72);
}

.mp-search-input {
  flex: 1;
  min-width: 0;
  color: #ffffff;
  font-size: 28rpx;
}

.mp-search-input::placeholder {
  color: #64748b;
}

.mp-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  min-width: 0;
}

.mp-chip {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-width: 0;
  min-height: 64rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  border: 1rpx solid rgba(148, 163, 184, 0.16);
  background: rgba(15, 23, 42, 0.7);
  color: #94a3b8;
  font-size: 24rpx;
  line-height: 1;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.mp-chip-active {
  border-color: rgba(34, 211, 238, 0.34);
  background: linear-gradient(135deg, rgba(34, 211, 238, 0.2), rgba(236, 72, 153, 0.14));
  color: #f8fafc;
  box-shadow: 0 10rpx 24rpx rgba(34, 211, 238, 0.16);
}

.mp-tag {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  border: 1rpx solid transparent;
  font-size: 22rpx;
  font-weight: 700;
  white-space: nowrap;
}

.mp-tag-cyan {
  background: rgba(34, 211, 238, 0.12);
  border-color: rgba(34, 211, 238, 0.28);
  color: #67e8f9;
}

.mp-tag-magenta {
  background: rgba(236, 72, 153, 0.12);
  border-color: rgba(236, 72, 153, 0.28);
  color: #f9a8d4;
}

.mp-tag-green {
  background: rgba(132, 204, 22, 0.12);
  border-color: rgba(132, 204, 22, 0.28);
  color: #bef264;
}

.mp-tag-yellow {
  background: rgba(250, 204, 21, 0.12);
  border-color: rgba(250, 204, 21, 0.28);
  color: #fde047;
}

.mp-tag-slate {
  background: rgba(148, 163, 184, 0.12);
  border-color: rgba(148, 163, 184, 0.24);
  color: #cbd5e1;
}

.mp-meta-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  min-width: 0;
}

.mp-meta-pill {
  display: inline-flex;
  align-items: center;
  min-height: 42rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: rgba(148, 163, 184, 0.08);
  color: #94a3b8;
  font-size: 22rpx;
  white-space: nowrap;
}

.mp-primary-btn,
.mp-secondary-btn {
  width: 100%;
  min-width: 0;
  height: 92rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0 24rpx;
  font-size: 28rpx;
  font-weight: 700;
  box-sizing: border-box;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mp-primary-btn {
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  background: linear-gradient(135deg, #22d3ee, #ec4899);
  color: #04111f;
  box-shadow: 0 14rpx 36rpx rgba(34, 211, 238, 0.18);
}

.mp-secondary-btn {
  border: 1rpx solid rgba(148, 163, 184, 0.22);
  background: rgba(15, 23, 42, 0.84);
  color: #f8fafc;
}

.mp-fixed-spacer {
  height: calc(180rpx + env(safe-area-inset-bottom));
}

.mp-fixed-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  gap: 16rpx;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(148, 163, 184, 0.14);
  background: rgba(7, 17, 31, 0.96);
}

.mp-fixed-bar .mp-primary-btn,
.mp-fixed-bar .mp-secondary-btn {
  flex: 1;
}

.mp-empty {
  padding: 120rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
}

.mp-empty-icon {
  font-size: 96rpx;
  margin-bottom: 18rpx;
}

.mp-empty-title {
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 700;
}

.mp-empty-text {
  margin-top: 12rpx;
  color: #64748b;
  font-size: 24rpx;
}

.mp-ellipsis {
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.mp-break-all {
  word-break: break-all;
}

@media (max-width: 360px) {
  .mp-page {
    padding-left: 18rpx;
    padding-right: 18rpx;
  }

  .mp-title {
    font-size: 44rpx;
  }

  .mp-primary-btn,
  .mp-secondary-btn {
    height: 86rpx;
    border-radius: 22rpx;
    font-size: 26rpx;
  }
}
